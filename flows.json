[
    {
        "id": "his-flow-main",
        "type": "tab",
        "label": "HIS Main",
        "disabled": false,
        "info": "Home Information System — main flow"
    },
    {
        "id": "his-broker",
        "type": "mqtt-broker",
        "name": "Mosquitto Local",
        "broker": "localhost",
        "port": "1883",
        "clientid": "nodered-his-hub",
        "autoConnect": true,
        "usetls": false,
        "protocolVersion": "4",
        "keepalive": "60",
        "cleansession": true
    },

    {
        "id": "his-ui-tab-pth",
        "type": "ui_tab",
        "name": "PTH Charts",
        "icon": "show_chart",
        "order": 1,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "his-ui-grp-pressure",
        "type": "ui_group",
        "name": "Pressure (PSI)",
        "tab": "his-ui-tab-pth",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "his-ui-grp-temp",
        "type": "ui_group",
        "name": "Temperature (°F)",
        "tab": "his-ui-tab-pth",
        "order": 2,
        "disp": true,
        "width": "12",
        "collapse": false
    },
    {
        "id": "his-ui-grp-humidity",
        "type": "ui_group",
        "name": "Humidity (%)",
        "tab": "his-ui-tab-pth",
        "order": 3,
        "disp": true,
        "width": "12",
        "collapse": false
    },

    {
        "id": "his-ui-tab-overview",
        "type": "ui_tab",
        "name": "Home Overview",
        "icon": "home",
        "order": 2,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "his-ui-grp-doors",
        "type": "ui_group",
        "name": "Doors & Windows",
        "tab": "his-ui-tab-overview",
        "order": 1,
        "disp": true,
        "width": "6",
        "collapse": false
    },
    {
        "id": "his-ui-grp-motion",
        "type": "ui_group",
        "name": "Motion",
        "tab": "his-ui-tab-overview",
        "order": 2,
        "disp": true,
        "width": "6",
        "collapse": false
    },

    {
        "id": "his-ui-tab-alarms",
        "type": "ui_tab",
        "name": "Alarms",
        "icon": "warning",
        "order": 3,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "his-ui-grp-gas",
        "type": "ui_group",
        "name": "Smoke / CO",
        "tab": "his-ui-tab-alarms",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },

    {
        "id": "his-ui-tab-frontdoor",
        "type": "ui_tab",
        "name": "Front Door",
        "icon": "camera_alt",
        "order": 4,
        "disabled": false,
        "hidden": false
    },
    {
        "id": "his-ui-grp-visitor",
        "type": "ui_group",
        "name": "Visitor",
        "tab": "his-ui-tab-frontdoor",
        "order": 1,
        "disp": true,
        "width": "12",
        "collapse": false
    },

    {
        "id": "his-mqtt-pth",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/+/pth",
        "topic": "home/+/pth",
        "qos": "0",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 160,
        "y": 120,
        "wires": [["his-fn-pressure", "his-fn-temp", "his-fn-humidity"]]
    },
    {
        "id": "his-fn-pressure",
        "type": "function",
        "z": "his-flow-main",
        "name": "extract P",
        "func": "msg.topic = msg.payload.device;\nmsg.payload = msg.payload.P;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 80,
        "wires": [["his-chart-pressure"]]
    },
    {
        "id": "his-fn-temp",
        "type": "function",
        "z": "his-flow-main",
        "name": "extract T",
        "func": "msg.topic = msg.payload.device;\nmsg.payload = msg.payload.T;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 120,
        "wires": [["his-chart-temp"]]
    },
    {
        "id": "his-fn-humidity",
        "type": "function",
        "z": "his-flow-main",
        "name": "extract RH",
        "func": "msg.topic = msg.payload.device;\nmsg.payload = msg.payload.RH;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 160,
        "wires": [["his-chart-humidity"]]
    },
    {
        "id": "his-chart-pressure",
        "type": "ui_chart",
        "z": "his-flow-main",
        "name": "Pressure",
        "group": "his-ui-grp-pressure",
        "order": 1,
        "width": 0,
        "height": 0,
        "label": "Pressure (PSI)",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "",
        "dot": false,
        "ymin": "",
        "ymax": "",
        "removeOlder": 30,
        "removeOlderUnit": "60",
        "removeOlderPoints": "",
        "colors": ["#1f77b4","#ff7f0e","#2ca02c","#d62728","#9467bd"],
        "useOldColors": false,
        "outputs": 1,
        "x": 600,
        "y": 80,
        "wires": [[]]
    },
    {
        "id": "his-chart-temp",
        "type": "ui_chart",
        "z": "his-flow-main",
        "name": "Temperature",
        "group": "his-ui-grp-temp",
        "order": 1,
        "width": 0,
        "height": 0,
        "label": "Temperature (°F)",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "",
        "dot": false,
        "ymin": "",
        "ymax": "",
        "removeOlder": 30,
        "removeOlderUnit": "60",
        "removeOlderPoints": "",
        "colors": ["#1f77b4","#ff7f0e","#2ca02c","#d62728","#9467bd"],
        "useOldColors": false,
        "outputs": 1,
        "x": 600,
        "y": 120,
        "wires": [[]]
    },
    {
        "id": "his-chart-humidity",
        "type": "ui_chart",
        "z": "his-flow-main",
        "name": "Humidity",
        "group": "his-ui-grp-humidity",
        "order": 1,
        "width": 0,
        "height": 0,
        "label": "Humidity (%)",
        "chartType": "line",
        "legend": "true",
        "xformat": "HH:mm:ss",
        "interpolate": "linear",
        "nodata": "",
        "dot": false,
        "ymin": "",
        "ymax": "",
        "removeOlder": 30,
        "removeOlderUnit": "60",
        "removeOlderPoints": "",
        "colors": ["#1f77b4","#ff7f0e","#2ca02c","#d62728","#9467bd"],
        "useOldColors": false,
        "outputs": 1,
        "x": 600,
        "y": 160,
        "wires": [[]]
    },

    {
        "id": "his-mqtt-door",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/+/door",
        "topic": "home/+/door",
        "qos": "1",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": true,
        "x": 160,
        "y": 280,
        "wires": [["his-fn-door-text"]]
    },
    {
        "id": "his-fn-door-text",
        "type": "function",
        "z": "his-flow-main",
        "name": "format door",
        "func": "var icon = msg.payload.state === 'open' ? '🔓 OPEN' : '🔒 closed';\nmsg.topic = msg.payload.device;\nmsg.payload = icon + '  (' + msg.topic + ')';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 280,
        "wires": [["his-text-door"]]
    },
    {
        "id": "his-text-door",
        "type": "ui_text",
        "z": "his-flow-main",
        "group": "his-ui-grp-doors",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Door Status",
        "label": "",
        "format": "{{msg.payload}}",
        "layout": "row-left",
        "x": 600,
        "y": 280,
        "wires": []
    },

    {
        "id": "his-mqtt-motion",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/+/motion",
        "topic": "home/+/motion",
        "qos": "0",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 160,
        "y": 340,
        "wires": [["his-fn-motion-text"]]
    },
    {
        "id": "his-fn-motion-text",
        "type": "function",
        "z": "his-flow-main",
        "name": "format motion",
        "func": "var icon = msg.payload.state === 'detected' ? '🚨 DETECTED' : '✅ clear';\nmsg.topic = msg.payload.device;\nmsg.payload = icon + '  (' + msg.topic + ')';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 340,
        "wires": [["his-text-motion"]]
    },
    {
        "id": "his-text-motion",
        "type": "ui_text",
        "z": "his-flow-main",
        "group": "his-ui-grp-motion",
        "order": 1,
        "width": 0,
        "height": 0,
        "name": "Motion Status",
        "label": "",
        "format": "{{msg.payload}}",
        "layout": "row-left",
        "x": 600,
        "y": 340,
        "wires": []
    },

    {
        "id": "his-mqtt-alarm",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/+/alarm",
        "topic": "home/+/alarm",
        "qos": "1",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 160,
        "y": 460,
        "wires": [["his-fn-alarm-gauge", "his-fn-alarm-check"]]
    },
    {
        "id": "his-fn-alarm-gauge",
        "type": "function",
        "z": "his-flow-main",
        "name": "smoke level",
        "func": "msg.topic = msg.payload.device;\nmsg.payload = msg.payload.smoke;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 440,
        "wires": [["his-gauge-smoke"]]
    },
    {
        "id": "his-gauge-smoke",
        "type": "ui_gauge",
        "z": "his-flow-main",
        "name": "Smoke Level",
        "group": "his-ui-grp-gas",
        "order": 1,
        "width": 6,
        "height": 4,
        "gtype": "gage",
        "title": "Smoke (ADC)",
        "label": "ADC counts",
        "format": "{{value}}",
        "min": 0,
        "max": 4095,
        "colors": ["#00b500","#e6e600","#e60000"],
        "seg1": 1500,
        "seg2": 2500,
        "x": 600,
        "y": 440,
        "wires": []
    },
    {
        "id": "his-fn-alarm-check",
        "type": "function",
        "z": "his-flow-main",
        "name": "alert if true",
        "func": "if (msg.payload.alert === true) {\n    msg.payload = '🚨 ALARM: ' + msg.payload.type.toUpperCase() + ' — node: ' + msg.payload.device;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 380,
        "y": 500,
        "wires": [["his-text-alarm-banner"]]
    },
    {
        "id": "his-text-alarm-banner",
        "type": "ui_text",
        "z": "his-flow-main",
        "group": "his-ui-grp-gas",
        "order": 2,
        "width": 12,
        "height": 0,
        "name": "Alarm Banner",
        "label": "⚠ Alert",
        "format": "{{msg.payload}}",
        "layout": "row-left",
        "x": 600,
        "y": 500,
        "wires": []
    },

    {
        "id": "his-mqtt-visitor",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/frontdoor/visitor",
        "topic": "home/frontdoor/visitor",
        "qos": "0",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 180,
        "y": 600,
        "wires": [["his-fn-visitor-text"]]
    },
    {
        "id": "his-fn-visitor-text",
        "type": "function",
        "z": "his-flow-main",
        "name": "visitor label",
        "func": "var trig = msg.payload.trigger === 'button' ? '🔔 Doorbell' : '👤 Motion';\nvar ts = new Date().toLocaleTimeString();\nmsg.payload = trig + '  @ ' + ts;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 420,
        "y": 600,
        "wires": [["his-text-visitor"]]
    },
    {
        "id": "his-text-visitor",
        "type": "ui_text",
        "z": "his-flow-main",
        "group": "his-ui-grp-visitor",
        "order": 1,
        "width": 12,
        "height": 0,
        "name": "Last Visitor",
        "label": "Last event",
        "format": "{{msg.payload}}",
        "layout": "row-left",
        "x": 640,
        "y": 600,
        "wires": []
    },
    {
        "id": "his-mqtt-image",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/frontdoor/image",
        "topic": "home/frontdoor/image",
        "qos": "0",
        "datatype": "buffer",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 180,
        "y": 660,
        "wires": [["his-fn-image-b64"]]
    },
    {
        "id": "his-fn-image-b64",
        "type": "function",
        "z": "his-flow-main",
        "name": "JPEG → base64 img",
        "func": "var b64 = msg.payload.toString('base64');\nmsg.payload = '<img src=\"data:image/jpeg;base64,' + b64 + '\" style=\"max-width:100%;border-radius:4px\"/>';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 440,
        "y": 660,
        "wires": [["his-template-image"]]
    },
    {
        "id": "his-template-image",
        "type": "ui_template",
        "z": "his-flow-main",
        "group": "his-ui-grp-visitor",
        "order": 2,
        "width": 12,
        "height": 9,
        "name": "Visitor Snapshot",
        "format": "{{{msg.payload}}}",
        "storeOutMessages": true,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "x": 680,
        "y": 660,
        "wires": [[]]
    },

    {
        "id": "his-telegram-config",
        "type": "telegram bot",
        "botname": "HIS Alert Bot",
        "usernames": "",
        "chatids": ""
    },
    {
        "id": "his-mqtt-visitor-tg",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/frontdoor/visitor (TG)",
        "topic": "home/frontdoor/visitor",
        "qos": "0",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 200,
        "y": 780,
        "wires": [["his-fn-tg-visitor"]]
    },
    {
        "id": "his-fn-tg-visitor",
        "type": "function",
        "z": "his-flow-main",
        "name": "build visitor TG msg",
        "func": "var trig = msg.payload.trigger === 'button' ? '🔔 Doorbell pressed' : '👤 Motion at front door';\nmsg.payload = {\n    chatId: env.get('TELEGRAM_CHAT_ID'),\n    type: 'message',\n    content: trig + ' — ' + new Date().toLocaleTimeString()\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 460,
        "y": 780,
        "wires": [["his-tg-sender-visitor"]]
    },
    {
        "id": "his-tg-sender-visitor",
        "type": "telegram sender",
        "z": "his-flow-main",
        "name": "send visitor alert",
        "bot": "his-telegram-config",
        "haserroroutput": false,
        "x": 700,
        "y": 780,
        "wires": [[]]
    },
    {
        "id": "his-mqtt-alarm-tg",
        "type": "mqtt in",
        "z": "his-flow-main",
        "name": "home/+/alarm (TG)",
        "topic": "home/+/alarm",
        "qos": "1",
        "datatype": "json",
        "broker": "his-broker",
        "nl": false,
        "rap": false,
        "x": 200,
        "y": 860,
        "wires": [["his-fn-tg-alarm"]]
    },
    {
        "id": "his-fn-tg-alarm",
        "type": "function",
        "z": "his-flow-main",
        "name": "build alarm TG msg",
        "func": "if (!msg.payload.alert) return null;\nmsg.payload = {\n    chatId: env.get('TELEGRAM_CHAT_ID'),\n    type: 'message',\n    content: '🚨 EMERGENCY: ' + msg.payload.type.toUpperCase() + ' detected at ' + msg.payload.device + '!\\nLevel: ' + (msg.payload.type === 'smoke' ? msg.payload.smoke : msg.payload.co)\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 460,
        "y": 860,
        "wires": [["his-tg-sender-alarm"]]
    },
    {
        "id": "his-tg-sender-alarm",
        "type": "telegram sender",
        "z": "his-flow-main",
        "name": "send alarm alert",
        "bot": "his-telegram-config",
        "haserroroutput": false,
        "x": 700,
        "y": 860,
        "wires": [[]]
    }
]
